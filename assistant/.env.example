# Copy to .env or export in your shell / hosting platform. All optional -
# with nothing set, the assistant runs in offline demo mode.

# Server
HOST=0.0.0.0
PORT=8000

# LLM (any OpenAI-compatible endpoint). Leave empty for offline demo mode.
# OpenAI:      LLM_BASE_URL=https://api.openai.com/v1            LLM_MODEL=gpt-4o-mini
# Groq:        LLM_BASE_URL=https://api.groq.com/openai/v1       LLM_MODEL=llama-3.3-70b-versatile
# OpenRouter:  LLM_BASE_URL=https://openrouter.ai/api/v1         LLM_MODEL=meta-llama/llama-3.3-70b-instruct
# Ollama:      LLM_BASE_URL=http://localhost:11434/v1            LLM_MODEL=llama3.1   (key can be "ollama")
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT=45

# Auth token signing secret (auto-generated into data/.secret if unset)
# ASSISTANT_SECRET=change-me-to-a-long-random-string

# Limits / storage
ASSISTANT_MAX_UPLOAD_MB=15
# ASSISTANT_DATA_DIR=/var/lib/carebridge-assistant
